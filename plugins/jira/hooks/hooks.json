{
  "description": "Atlassian Jira Workflows: session analytics, work item linking, and the commit guard.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook cache-user",
            "timeout": 10,
            "statusMessage": "Jira: caching your Atlassian user"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" gc",
            "statusMessage": "Jira: sweeping stale session data"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook session-analytics",
            "async": true,
            "timeout": 10,
            "statusMessage": "Jira: recording the session start"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" session signal flush",
            "async": true,
            "timeout": 10,
            "statusMessage": "Jira: sending pending work item signals"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook jira-launch",
            "async": true,
            "timeout": 10,
            "statusMessage": "Jira: detecting a Jira-launched session"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "(.*:)?jira-workflows",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook onboarding",
            "timeout": 3,
            "statusMessage": "Jira: showing the first-use guide"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook skill-analytics",
            "async": true,
            "timeout": 10,
            "statusMessage": "Jira: recording the skill invocation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook commit-guard",
            "timeout": 3,
            "statusMessage": "Jira: guarding commits to the default branch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/link-prompt-gate.sh\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "async": false,
            "timeout": 10,
            "statusMessage": "Jira: offering to link a work item"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook onboarding",
            "timeout": 3,
            "statusMessage": "Jira: showing the first-use guide"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook skill-analytics",
            "async": true,
            "timeout": 10,
            "statusMessage": "Jira: recording the skill invocation"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook session-end-flush",
            "timeout": 3,
            "statusMessage": "Jira: sending work item signals at session end"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/jira-cli.mjs\" hook session-end-signal",
            "timeout": 3,
            "statusMessage": "Jira: recording the session end"
          }
        ]
      }
    ]
  },
  "modules": ["./jira-view/register.tsx"]
}
